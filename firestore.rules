// Firestore rules for Arise. Deploy with `npx firebase-tools deploy --only firestore:rules`
// (see firebase.json), or paste into Firebase console, Firestore Database, Rules, then Publish.
//
// Each signed-in person can only reach their own folders (users/<their id>/arise/... and, for the
// life log, users/<their id>/life/...), and only in the encrypted shape the app writes: the server
// refuses plain data, oversized documents and any other document names. It never holds anything
// it could read, except the data key of an account that chose Email reset (byEmail below): only
// that account can fetch it, but whoever runs this project could read it. A goal shared with a
// friend (shares/ below) is sealed with a key that's only in its link, so the server can't read
// that either.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function shortString(v, max) {
      return v is string && v.size() <= max;
    }
    // AES-GCM output from the app: base64 IV and ciphertext.
    function sealed(v, max) {
      return v is map && v.keys().hasOnly(['iv', 'ct']) && shortString(v.iv, 24) && shortString(v.ct, max);
    }
    // A 256-bit key as it is, in base64.
    function rawKey(v) {
      return v is string && v.size() == 44 && v.matches('[A-Za-z0-9+/]{43}=');
    }
    // One passkey's wrap of the data key: which passkey (a hash of its id, 43 characters of
    // base64url) and the key sealed with a secret only that passkey makes, on the device.
    function passkeyWrap(w) {
      return w is map && w.keys().hasOnly(['id', 'iv', 'ct']) && w.keys().hasAll(['id', 'iv', 'ct'])
        && w.id is string && w.id.matches('[A-Za-z0-9_-]{43}')
        && shortString(w.iv, 24) && shortString(w.ct, 200);
    }
    // Up to 10 of them, each checked (the rules can't loop, so one by one).
    function passkeyWraps(v) {
      return v is list && v.size() <= 10
        && (v.size() < 1 || passkeyWrap(v[0]))
        && (v.size() < 2 || passkeyWrap(v[1]))
        && (v.size() < 3 || passkeyWrap(v[2]))
        && (v.size() < 4 || passkeyWrap(v[3]))
        && (v.size() < 5 || passkeyWrap(v[4]))
        && (v.size() < 6 || passkeyWrap(v[5]))
        && (v.size() < 7 || passkeyWrap(v[6]))
        && (v.size() < 8 || passkeyWrap(v[7]))
        && (v.size() < 9 || passkeyWrap(v[8]))
        && (v.size() < 10 || passkeyWrap(v[9]));
    }
    // A shared goal's page: the snapshot sealed with the link's key (a 12-byte IV and the
    // ciphertext, in base64), the account that made it, and when it was last updated.
    function sharePage(d) {
      return d.keys().hasOnly(['owner', 'iv', 'ct', 'v', 'updated'])
        && d.owner is string
        && d.iv is string && d.iv.matches('[A-Za-z0-9+/]{16}')
        && shortString(d.ct, 20000) && d.ct.matches('[A-Za-z0-9+/]+={0,2}')
        && d.v == 1
        && d.updated is int;
    }
    // What a page becomes when its link is turned off or replaced: nothing is left in it, not even
    // whose it was, and nobody can change it again.
    function shareOff(d) {
      return d.keys().hasOnly(['v', 'off']) && d.v == 1 && d.off == true;
    }
    // The life log's documents: 'key' (the life key, sealed with the account's data key), 'index'
    // (which packs there are, sealed) and the parts of the packs, whose ids are 43 characters of
    // base64url (an HMAC, so they don't tell which months there's anything in).
    function lifeId(id) {
      return id == 'key' || id == 'index' || id.matches('[A-Za-z0-9_-]{43}');
    }
    // Each one sealed: a 12-byte IV and up to 700,000 characters of ciphertext, in base64, and
    // when it was written. Nothing else.
    function lifePack(d) {
      return d.keys().hasOnly(['v', 'iv', 'ct', 'updated'])
        && d.keys().hasAll(['v', 'iv', 'ct', 'updated'])
        && d.v == 1
        && d.iv is string && d.iv.matches('[A-Za-z0-9+/]{16}')
        && d.ct is string && d.ct.size() >= 1 && d.ct.size() <= 700000 && d.ct.matches('[A-Za-z0-9+/]+={0,2}')
        && d.updated is int;
    }

    // Which version is current, and the IV for its ciphertext.
    match /users/{uid}/arise/meta {
      allow read, delete: if owner(uid);
      allow write: if owner(uid)
        && request.resource.data.keys().hasOnly(['rev', 'parts', 'enc', 'iv', 'schema'])
        && shortString(request.resource.data.rev, 32)
        && request.resource.data.parts is int && request.resource.data.parts >= 1 && request.resource.data.parts <= 20
        && request.resource.data.enc == 1
        && shortString(request.resource.data.iv, 24)
        && request.resource.data.schema is int && request.resource.data.schema >= 1 && request.resource.data.schema <= 1000;
    }

    // The data key, wrapped by the password and by the recovery code. With Email reset, also as
    // it is (byEmail), so a password set from a reset email can open it again. `wasEmail: true`
    // says it has been kept so, now or before. `byPasskey`: wrapped by each passkey that unlocks
    // the data too (src/account.ts). (Anyone who gets into an account's email can set
    // a password and write these too, so the app never takes them on trust.)
    match /users/{uid}/arise/keys {
      allow read, delete: if owner(uid);
      allow write: if owner(uid)
        && request.resource.data.keys().hasOnly(['v', 'iter', 'byPassword', 'byRecovery', 'byEmail', 'wasEmail', 'byPasskey'])
        && request.resource.data.v == 1
        && request.resource.data.iter is int
        && sealed(request.resource.data.byPassword, 200)
        && sealed(request.resource.data.byRecovery, 200)
        && (!('byEmail' in request.resource.data) || rawKey(request.resource.data.byEmail))
        && (!('wasEmail' in request.resource.data) || request.resource.data.wasEmail == true)
        && (!('byPasskey' in request.resource.data) || passkeyWraps(request.resource.data.byPasskey));
    }

    // Sign out of all devices (src/lib/session-cut.ts): when the account last chose it, and whether
    // those devices also remove Arise's data. The time is the database's own (request.time), so no
    // device's clock can set it. Every device signed in before it signs itself out. Nothing of the
    // account's data is in it.
    match /users/{uid}/arise/signout {
      allow read, delete: if owner(uid);
      allow write: if owner(uid)
        && request.resource.data.keys().hasOnly(['v', 'at', 'wipe'])
        && request.resource.data.keys().hasAll(['v', 'at', 'wipe'])
        && request.resource.data.v == 1
        && request.resource.data.at == request.time
        && request.resource.data.wipe is bool;
    }

    // The ciphertext, up to 20 parts of 700,000 characters.
    match /users/{uid}/arise/{part} {
      allow read, delete: if owner(uid) && part.matches('part[0-9]{1,2}');
      allow write: if owner(uid)
        && part.matches('part([0-9]|1[0-9])')
        && request.resource.data.keys().hasOnly(['rev', 'ct'])
        && shortString(request.resource.data.rev, 32)
        && shortString(request.resource.data.ct, 700000);
    }

    // The life log (src/life/cloud.ts), sealed in packs. Only its account reads, writes or lists
    // them, and deletes them (when the account is deleted, or a pack has nothing left).
    match /users/{uid}/life/{doc} {
      allow get, delete: if owner(uid) && lifeId(doc);
      allow list: if owner(uid);
      allow create, update: if owner(uid) && lifeId(doc) && lifePack(request.resource.data);
    }

    // For a forgotten password: the Firebase password, sealed with the recovery code. Useless
    // without that code, so anyone may fetch one by its login email (no listing). Only the
    // account with that email can write it, so nobody can take someone else's. `email: true`
    // says the account uses Email reset, so the app knows before signing in.
    match /recovery/{email} {
      allow get: if true;
      allow create, update: if request.auth != null
        && request.auth.token.email == email
        && request.resource.data.keys().hasOnly(['uid', 'auth', 'email'])
        && request.resource.data.uid == request.auth.uid
        && sealed(request.resource.data.auth, 400)
        && (!('email' in request.resource.data) || request.resource.data.email == true);
      allow delete: if request.auth != null && request.auth.token.email == email;
    }

    // A goal's progress, shared with a friend: the link is <site>#share=<id>.<key>, and the part
    // after the # never reaches a server. Anyone with the link may fetch the page by its id (128
    // random bits), but only the key in the link opens it. Only the account that made it can
    // update it, and it stays that account's. An account may list only its own, to turn them all
    // off when it's deleted.
    //
    // A link that's turned off stays off: its page becomes shareOff, which nobody can change, and
    // it's never deleted. Otherwise its id would be free again, and anyone with the old link could
    // put a page of their own there, which the old link would open as the Player's.
    match /shares/{id} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null
        && id.matches('[A-Za-z0-9_-]{22}')
        && (shareOff(request.resource.data)
          || (sharePage(request.resource.data) && request.resource.data.owner == request.auth.uid));
      allow update: if request.auth != null
        && resource.data.get('owner', null) == request.auth.uid
        && (shareOff(request.resource.data)
          || (sharePage(request.resource.data) && request.resource.data.owner == resource.data.owner));
    }
  }
}
